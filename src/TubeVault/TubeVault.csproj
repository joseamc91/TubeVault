<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets/Branding/AppIcon.ico</ApplicationIcon>

    <AssemblyName>TubeVault</AssemblyName>
    <RootNamespace>TubeVault</RootNamespace>
    <Product>TubeVault</Product>
    <Description>Aplicación sencilla para descargar música en MP3.</Description>
    <Authors>joseamc91</Authors>
    <Company>TubeVault</Company>
    <Copyright>Copyright © 2026 joseamc91</Copyright>
    <RepositoryUrl>https://github.com/joseamc91/TubeVault</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>2026.10.2</Version>
    <AssemblyVersion>2026.10.2.0</AssemblyVersion>
    <FileVersion>2026.10.2.0</FileVersion>
    <InformationalVersion>2026.10.002</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/Branding/AppIcon.ico" LogicalName="TubeVault.Branding.AppIcon.ico" />
    <EmbeddedResource Include="Assets/Branding/Wordmark-Light.png" LogicalName="TubeVault.Branding.Wordmark-Light.png" />
    <EmbeddedResource Include="Assets/Branding/Wordmark-Dark.png" LogicalName="TubeVault.Branding.Wordmark-Dark.png" />
  </ItemGroup>

</Project>
